{
  "name": "package-template",
  "version": "0.0.1",
  "description": "My package's description",
  "license": "MIT",
  "author": {
    "name": "Dani Guardiola",
    "email": "github.contact@alias.dio.la",
    "url": "https://dio.la/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "publish": "bun run build && changeset publish",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tsconfig/strictest": "^2.0.8",
    "bun-types": "^1.3.13",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13"
}
